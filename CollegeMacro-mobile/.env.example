# Copy to .env (or run `npm run env` from the repo root). Never commit .env.
# These are bundled into the app, so only public values belong here:
# never the Supabase service role key or the Anthropic key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Where the backend runs, e.g. http://192.168.1.20:3001 on your Wi-Fi while developing.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001
