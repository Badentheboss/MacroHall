# Copy this file to .env and fill in your values.
# Never commit .env to Git.

SUPABASE_URL=https://your-project-id.supabase.co
# Server-side only. Never put this key in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Claude powers the campus chatbot, menu-photo reading and PDF/web menu extraction.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: defaults to claude-opus-5-5. claude-sonnet-5-5 or claude-haiku-4-5 cost less.
# CLAUDE_MODEL=claude-opus-5-5
# Optional: chatbot questions + menu photos per student per day (default 40).
# AI_DAILY_LIMIT=40

# Required to call POST /ingest (send it as "Authorization: Bearer <secret>").
INGEST_SECRET=generate-a-long-random-string

# Optional — defaults to 3001
PORT=3001
