{
  "name": "collegemacro-backend",
  "version": "1.0.0",
  "description": "Multi-school dining ingestion backend with per-school parser adapters and normalized storage.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "ingest": "node src/cli/ingest.js",
    "ingest:all": "node src/cli/ingest.js --school=all --persist=true",
    "test": "node --test tests/*.test.js",
    "db:seed-sql": "node src/cli/buildSeed.js > src/db/seed/schools.sql",
    "discover": "node src/cli/discover.js",
    "capture": "node src/cli/capture.js"
  },
  "keywords": [
    "dining",
    "nutrition",
    "supabase",
    "parser"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.39.8",
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "puppeteer": "^24.26.1",
    "touch": "^3.1.0",
    "vercel": "^33.6.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vercel/node": "^3.0.26"
  }
}
